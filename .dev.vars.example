# Пример переменных для локальной разработки (`wrangler dev`).
# Скопируйте в файл `.dev.vars` и подставьте СВОИ значения.
# `.dev.vars` не коммитить! Реальных секретов здесь быть не должно.
BOT_TOKEN=123456:REPLACE_WITH_REAL_BOT_TOKEN
ADMIN_CHAT_ID=-1001234567890
WEBHOOK_SECRET=replace_with_long_random_string
