{
  "name": "aura-wellness-bot",
  "version": "1.0.0",
  "private": true,
  "description": "AURA Wellness Studio — Telegram-бот на Cloudflare Workers (webhook, TypeScript).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "webhook:set": "node scripts/webhook.mjs set",
    "webhook:info": "node scripts/webhook.mjs info",
    "webhook:delete": "node scripts/webhook.mjs delete"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
