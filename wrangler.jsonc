{
  // AURA Wellness Studio — Telegram-бот на Cloudflare Workers (webhook).
  "name": "raspy-hall-8b2c",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,

  // KV для временного состояния пользователей (шаги записи, ожидание отзыва/обращения).
  // Создайте namespace командой:
  //   npx wrangler kv namespace create BOT_STATE
  // и вставьте полученные id ниже. Секреты (BOT_TOKEN, ADMIN_CHAT_ID,
  // WEBHOOK_SECRET) задаются отдельно через `wrangler secret put`, а не здесь.
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "83130215cb284f308d629c09da8bafd5",
    }
  ]
}
